# systemd user unit for the obsidian-notes-rag watcher daemon (Ubuntu).
#
# Install (user mode, no sudo):
#   mkdir -p ~/.config/systemd/user
#   cp extras/obsidian-notes-rag-watcher.service ~/.config/systemd/user/
#   # Edit ExecStart / Environment below to match your setup, then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now obsidian-notes-rag-watcher.service
#
# Useful commands:
#   systemctl --user status obsidian-notes-rag-watcher.service
#   journalctl --user -u obsidian-notes-rag-watcher.service -f
#   systemctl --user restart obsidian-notes-rag-watcher.service
#
# Run at boot without an active login session:
#   loginctl enable-linger "$USER"
#
# Configuration is normally read from the app config file
# (created by `obsidian-rag setup`). Uncomment the Environment=
# lines below to override it for the service.

[Unit]
Description=obsidian-notes-rag watcher - auto-index notes on change
Documentation=https://github.com/proofgeist/obsidian-notes-rag
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
# Default install location for `uv tool install` / pipx. Adjust if needed, e.g.:
#   ExecStart=%h/.venv/bin/obsidian-notes-rag watch
#   ExecStart=/usr/local/bin/obsidian-notes-rag watch
ExecStart=%h/.local/bin/obsidian-notes-rag watch
# Mirrors the macOS launchd KeepAlive + ThrottleInterval=30 behaviour.
Restart=always
RestartSec=30
# Optional overrides (config file values are used when commented out):
#Environment=OBSIDIAN_RAG_VAULT=%h/Documents/vault
#Environment=OBSIDIAN_RAG_DATA=%h/.local/share/obsidian-notes-rag
#Environment=OBSIDIAN_RAG_PROVIDER=ollama
#Environment=OBSIDIAN_RAG_OLLAMA_URL=http://localhost:11434
#Environment=OBSIDIAN_RAG_MODEL=nomic-embed-text
#Environment=OBSIDIAN_RAG_DEBOUNCE=2.0
# NOTE: do not commit secrets here (unit files are world-readable).
# For API keys prefer `systemctl --user edit obsidian-notes-rag-watcher.service`
# with e.g. `Environment=OPENAI_API_KEY=...`.

[Install]
WantedBy=default.target
